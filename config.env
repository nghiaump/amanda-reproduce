# Cấu hình chung cho mọi bước. Ba cách đổi một giá trị (ưu tiên từ trên xuống):
#   1. biến môi trường ngay trên dòng lệnh:   USE_SNAPSHOT=1 bash steps/06_captions.sh
#   2. config.local.env (tạo mới, không bị git theo dõi), vd. một dòng  AMANDA_LLM_URL=http://127.0.0.1:8110/v1
#   3. sửa trực tiếp giá trị mặc định dưới đây.

# ── GPU ──────────────────────────────────────────────────────────────────────────────
GPU_LLAVA=${GPU_LLAVA:-1}                 # card chạy LLaVA-Med v1.5 7B (cần ~15 GB VRAM trống)
GPU_LLM=${GPU_LLM:-0}                   # card chạy vLLM (chỉ dùng khi tự dựng server ở bước 05; cần ~21 GB)

# ── LLM cho các agent Reasoner / Evaluator / Explorer / trích entity ───────────────────
# Bất kỳ server nào nói giao thức OpenAI /v1/chat/completions đều dùng được.
# Đã có sẵn server gemma-4-26b ở đâu đó thì chỉ cần trỏ AMANDA_LLM_URL tới đó và bỏ qua bước 05.
AMANDA_LLM_URL=${AMANDA_LLM_URL:-http://127.0.0.1:4001/v1}
AMANDA_LLM_MODEL=${AMANDA_LLM_MODEL:-gemma-4-26b}          # tên model mà server công bố (served-model-name)
LLM_HF_ID=${LLM_HF_ID:-cyankiwi/gemma-4-26B-A4B-it-AWQ-4bit}
LLM_PORT=${LLM_PORT:-4001}
LLM_MAX_LEN=${LLM_MAX_LEN:-8192}
LLM_GPU_UTIL=${LLM_GPU_UTIL:-0.88}
LLM_MAX_SEQS=${LLM_MAX_SEQS:-16}

# ── Chạy thí nghiệm ────────────────────────────────────────────────────────────────────
WORKERS=${WORKERS:-6}                   # số câu xử lý song song (LLaVA-Med vẫn tuần tự qua khoá; song song chỉ ở phần gọi LLM)
REPS=${REPS:-3}                      # số lượt lặp cho mỗi arm ở bước 10 và 11
EXTRA_ARMS=${EXTRA_ARMS:-}                # arm thêm cho bước 10, cách nhau bởi dấu cách: C2 B2 C5 (mặc định: không)
MAX_TRIES=${MAX_TRIES:-3}                 # một lượt chạy bị đứt thì tự chạy tiếp tối đa bấy nhiêu lần
LLM_WAIT_MIN=${LLM_WAIT_MIN:-30}             # chờ server LLM tối đa bấy nhiêu phút trước mỗi lượt

# 1 = bước 06 chép caption từ snapshot/amanda-A/captions_patched.json thay vì sinh bằng GPU, và bước 07 nạp sẵn
# cache SPOKE từ snapshot/amanda-A/spoke_cache trước khi chạy. 0 = tự sinh toàn bộ (xem README mục 7, bước 06–07).
USE_SNAPSHOT=${USE_SNAPSHOT:-0}

# ── Weights & Biases ───────────────────────────────────────────────────────────────────
# online  = log trực tiếp lên wandb.ai (cần `wandb login` một lần, hoặc biến WANDB_API_KEY trong môi trường)
# offline = ghi vào ./wandb trên máy, đưa lên sau bằng `wandb sync` (mặc định: chạy được khi chưa có tài khoản)
# disabled = không dùng W&B; bước 15 bỏ qua
WANDB_PROJECT=${WANDB_PROJECT:-amanda-slake-reproduction}
WANDB_ENTITY=${WANDB_ENTITY:-}            # tài khoản hoặc team W&B; để trống = tài khoản mặc định của khoá API
WANDB_MODE=${WANDB_MODE:-offline}

# ── Mã nguồn bên thứ ba (ghim commit) ─────────────────────────────────────────────────
AMANDA_GIT=${AMANDA_GIT:-https://github.com/REAL-Lab-NU/AMANDA.git}
AMANDA_COMMIT=${AMANDA_COMMIT:-12fd7e41168467a9cb82b9bb8c9a930f2ed96816}
LLAVA_GIT=${LLAVA_GIT:-https://github.com/microsoft/LLaVA-Med.git}
LLAVA_COMMIT=${LLAVA_COMMIT:-30697ca50b5c29a8e955c99330b259776aef27b9}
LLAVA_HF_ID=${LLAVA_HF_ID:-microsoft/llava-med-v1.5-mistral-7b}

# ── Dữ liệu ─────────────────────────────────────────────────────────────────────────────
SLAKE_URL=${SLAKE_URL:-https://huggingface.co/datasets/BoKelvin/SLAKE/resolve/main}
SLAKE_TEST_SHA256=${SLAKE_TEST_SHA256:-6be8f7b4c5a46cdbc713a5210a25b6ed5aa1fd1574c83cefb4f998131f17c2c3}
SPOKE_URL=${SPOKE_URL:-https://spoke.rbvi.ucsf.edu}
